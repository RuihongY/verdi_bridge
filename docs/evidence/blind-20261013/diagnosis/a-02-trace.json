            "line": 103,
            "text": ""
          },
          {
            "line": 104,
            "text": "    if (ARB_BLOCK && !ARB_BLOCK_ACK && grant_reg & request) begin"
          },
          {
            "line": 105,
            "text": "        // granted request still asserted; hold it"
          },
          {
            "line": 106,
            "text": "        grant_valid_next = grant_valid_reg;"
          },
