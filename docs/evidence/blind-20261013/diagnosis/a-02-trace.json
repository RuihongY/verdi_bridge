          {
            "line": 108,
            "text": "        grant_encoded_next = grant_encoded_reg;"
          },
          {
            "line": 109,
            "text": "    end else if (ARB_BLOCK && ARB_BLOCK_ACK && grant_valid && !(grant_reg & acknowledge)) begin"
          },
          {
            "line": 110,
            "text": "        // granted request not yet acknowledged; hold it"
          },
          {
            "line": 111,
            "text": "        grant_valid_next = grant_valid_reg;"
          },
          {
            "line": 112,
            "text": "        grant_next = grant_reg;"
          },
          {
            "line": 113,
            "text": "        grant_encoded_next = grant_encoded_reg;"
          },
          {
            "line": 114,
            "text": "    end else if (request_valid) begin"
          },
          {
            "line": 115,
            "text": "        if (ARB_TYPE_ROUND_ROBIN) begin"
          },
          {
            "line": 116,
            "text": "            if (masked_request_valid) begin"
          },
          {
            "line": 117,
            "text": "                grant_valid_next = 1;"
          },
          {
            "line": 118,
            "text": "                grant_next = masked_request_mask;"
          },
          {
            "line": 119,
            "text": "                grant_encoded_next = request_index;"
          },
          {
            "line": 120,
            "text": "                if (ARB_LSB_HIGH_PRIORITY) begin"
          },
          {
            "line": 121,
            "text": "                    mask_next = {PORTS{1'b1}} << (masked_request_index + 1);"
          },
          {
            "line": 122,
            "text": "                end else begin"
          },
          {
            "line": 123,
            "text": "                    mask_next = {PORTS{1'b1}} >> (PORTS - masked_request_index);"
          },
          {
            "line": 124,
            "text": "                end"
          },
          {
            "line": 125,
            "text": "            end else begin"
          },
          {
            "line": 126,
            "text": "                grant_valid_next = 1;"
          },
          {
            "line": 127,
            "text": "                grant_next = request_mask;"
          },
          {
            "line": 128,
            "text": "                grant_encoded_next = request_index;"
          },
          {
            "line": 129,
            "text": "                if (ARB_LSB_HIGH_PRIORITY) begin"
          },
          {
            "line": 130,
            "text": "                    mask_next = {PORTS{1'b1}} << (request_index + 1);"
          },
          {
            "line": 131,
            "text": "                end else begin"
          },
          {
            "line": 132,
            "text": "                    mask_next = {PORTS{1'b1}} >> (PORTS - request_index);"
