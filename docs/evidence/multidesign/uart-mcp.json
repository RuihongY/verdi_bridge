          {
            "line": 51,
            "text": ""
          },
          {
            "line": 52,
            "text": "    /*"
          },
          {
            "line": 53,
            "text": "     * Status"
          },
          {
            "line": 54,
            "text": "     */"
          },
          {
            "line": 55,
            "text": "    output wire                   busy,"
          },
          {
            "line": 56,
            "text": ""
          },
          {
            "line": 57,
            "text": "    /*"
          },
          {
            "line": 58,
            "text": "     * Configuration"
          },
          {
            "line": 59,
            "text": "     */"
          },
          {
            "line": 60,
            "text": "    input  wire [15:0]            prescale"
          },
          {
            "line": 61,
            "text": ");"
          },
          {
            "line": 62,
            "text": ""
          },
          {
            "line": 63,
            "text": "reg s_axis_tready_reg = 0;"
          },
          {
            "line": 64,
            "text": ""
          },
          {
            "line": 65,
            "text": "reg txd_reg = 1;"
          },
          {
            "line": 66,
            "text": ""
          },
          {
            "line": 67,
            "text": "reg busy_reg = 0;"
          },
          {
            "line": 68,
            "text": ""
          },
          {
            "line": 69,
            "text": "reg [DATA_WIDTH:0] data_reg = 0;"
          },
          {
            "line": 70,
            "text": "reg [18:0] prescale_reg = 0;"
          },
          {
            "line": 71,
            "text": "reg [3:0] bit_cnt = 0;"
          },
          {
            "line": 72,
            "text": ""
          },
          {
            "line": 73,
            "text": "assign s_axis_tready = s_axis_tready_reg;"
          },
          {
            "line": 74,
            "text": "assign txd = txd_reg;"
          },
          {
            "line": 75,
            "text": ""
          },
          {
            "line": 76,
            "text": "assign busy = busy_reg;"
          },
          {
            "line": 77,
            "text": ""
          },
          {
            "line": 78,
            "text": "always @(posedge clk) begin"
          },
          {
            "line": 79,
            "text": "    if (rst) begin"
          },
          {
            "line": 80,
            "text": "        s_axis_tready_reg <= 0;"
          },
          {
            "line": 81,
            "text": "        txd_reg <= 1;"
          },
          {
            "line": 82,
            "text": "        prescale_reg <= 0;"
          },
          {
            "line": 83,
            "text": "        bit_cnt <= 0;"
          },
          {
            "line": 84,
            "text": "        busy_reg <= 0;"
          },
          {
            "line": 85,
            "text": "    end else begin"
          },
          {
            "line": 86,
            "text": "        if (prescale_reg > 0) begin"
          },
          {
            "line": 87,
            "text": "            s_axis_tready_reg <= 0;"
          },
          {
            "line": 88,
            "text": "            prescale_reg <= prescale_reg - 1;"
          },
          {
            "line": 89,
            "text": "        end else if (bit_cnt == 0) begin"
          },
          {
            "line": 90,
            "text": "            s_axis_tready_reg <= 1;"
          },
          {
            "line": 91,
            "text": "            busy_reg <= 0;"
          },
          {
            "line": 92,
            "text": ""
          },
          {
            "line": 93,
            "text": "            if (s_axis_tvalid) begin"
          },
          {
            "line": 94,
            "text": "                s_axis_tready_reg <= !s_axis_tready_reg;"
          },
          {
            "line": 95,
            "text": "                prescale_reg <= (prescale << 3)-1;"
          },
          {
            "line": 96,
            "text": "                bit_cnt <= DATA_WIDTH;"
          },
          {
            "line": 97,
            "text": "                data_reg <= {1'b1, s_axis_tdata};"
          },
          {
            "line": 98,
            "text": "                txd_reg <= 0;"
          },
          {
            "line": 99,
            "text": "                busy_reg <= 1;"
          },
          {
            "line": 100,
            "text": "            end"
          },
          {
            "line": 101,
            "text": "        end else begin"
          },
          {
            "line": 102,
            "text": "            if (bit_cnt > 1) begin"
          },
          {
            "line": 103,
            "text": "                bit_cnt <= bit_cnt - 1;"
          },
          {
            "line": 104,
            "text": "                prescale_reg <= (prescale << 3)-1;"
          },
          {
            "line": 105,
            "text": "                {data_reg, txd_reg} <= {1'b0, data_reg};"
          },
          {
            "line": 106,
            "text": "            end else if (bit_cnt == 1) begin"
          },
          {
            "line": 107,
            "text": "                bit_cnt <= bit_cnt - 1;"
          },
          {
            "line": 108,
            "text": "                prescale_reg <= (prescale << 3);"
          },
          {
            "line": 109,
            "text": "                txd_reg <= 1;"
          },
          {
            "line": 110,
            "text": "            end"
          },
          {
            "line": 111,
            "text": "        end"
          },
          {
            "line": 112,
            "text": "    end"
          },
          {
