          {
            "line": 38,
            "text": "    input  wire                   rst,"
          },
          {
            "line": 39,
            "text": ""
          },
          {
            "line": 40,
            "text": "    /*"
          },
          {
            "line": 41,
            "text": "     * AXI input"
          },
          {
            "line": 42,
            "text": "     */"
          },
          {
            "line": 43,
            "text": "    input  wire [DATA_WIDTH-1:0]  s_axis_tdata,"
          },
          {
            "line": 44,
            "text": "    input  wire                   s_axis_tvalid,"
          },
          {
            "line": 45,
            "text": "    output wire                   s_axis_tready,"
          },
          {
            "line": 46,
            "text": ""
          },
          {
            "line": 47,
            "text": "    /*"
          },
          {
            "line": 48,
            "text": "     * UART interface"
          },
          {
            "line": 49,
            "text": "     */"
          },
          {
            "line": 50,
            "text": "    output wire                   txd,"
