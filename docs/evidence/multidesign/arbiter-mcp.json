          {
            "line": 90,
            "text": ")"
          },
          {
            "line": 91,
            "text": "priority_encoder_masked ("
          },
          {
            "line": 92,
            "text": "    .input_unencoded(request & mask_reg),"
          },
          {
            "line": 93,
            "text": "    .output_valid(masked_request_valid),"
          },
          {
            "line": 94,
            "text": "    .output_encoded(masked_request_index),"
          },
          {
            "line": 95,
            "text": "    .output_unencoded(masked_request_mask)"
