          },
          {
            "line": 97,
            "text": ""
          },
          {
            "line": 98,
            "text": "always @* begin"
          },
          {
            "line": 99,
            "text": "    grant_next = 0;"
          },
          {
            "line": 100,
            "text": "    grant_valid_next = 0;"
          },
          {
            "line": 101,
            "text": "    grant_encoded_next = 0;"
          },
          {
            "line": 102,
            "text": "    mask_next = mask_reg;"
          },
          {
            "line": 103,
            "text": ""
          },
          {
            "line": 104,
            "text": "    if (ARB_BLOCK && !ARB_BLOCK_ACK && grant_reg & request) begin"
          },
          {
            "line": 105,
            "text": "        // granted request still asserted; hold it"
          },
          {
            "line": 106,
            "text": "        grant_valid_next = grant_valid_reg;"
          },
          {
            "line": 107,
            "text": "        grant_next = grant_reg;"
