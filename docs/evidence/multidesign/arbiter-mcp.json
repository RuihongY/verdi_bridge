            "line": 48,
            "text": "    input  wire                     rst,"
          },
          {
            "line": 49,
            "text": ""
          },
          {
            "line": 50,
            "text": "    input  wire [PORTS-1:0]         request,"
          },
          {
            "line": 51,
            "text": "    input  wire [PORTS-1:0]         acknowledge,"
          },
          {
            "line": 52,
            "text": ""
          },
          {
            "line": 53,
            "text": "    output wire [PORTS-1:0]         grant,"
          },
          {
            "line": 54,
            "text": "    output wire                     grant_valid,"
          },
          {
            "line": 55,
            "text": "    output wire [$clog2(PORTS)-1:0] grant_encoded"
          },
          {
            "line": 56,
            "text": ");"
          },
          {
            "line": 57,
            "text": ""
          },
          {
            "line": 58,
            "text": "reg [PORTS-1:0] grant_reg = 0, grant_next;"
          },
          {
            "line": 59,
            "text": "reg grant_valid_reg = 0, grant_valid_next;"
          },
          {
            "line": 60,
            "text": "reg [$clog2(PORTS)-1:0] grant_encoded_reg = 0, grant_encoded_next;"
          },
          {
            "line": 61,
            "text": ""
          },
          {
            "line": 62,
            "text": "assign grant_valid = grant_valid_reg;"
          },
          {
            "line": 63,
            "text": "assign grant = grant_reg;"
          },
          {
            "line": 64,
            "text": "assign grant_encoded = grant_encoded_reg;"
          },
          {
            "line": 65,
            "text": ""
          },
          {
            "line": 66,
            "text": "wire request_valid;"
          },
          {
            "line": 67,
            "text": "wire [$clog2(PORTS)-1:0] request_index;"
          },
          {
            "line": 68,
            "text": "wire [PORTS-1:0] request_mask;"
          },
          {
            "line": 69,
            "text": ""
          },
          {
            "line": 70,
            "text": "priority_encoder #("
          },
          {
            "line": 71,
            "text": "    .WIDTH(PORTS),"
          },
          {
            "line": 72,
            "text": "    .LSB_HIGH_PRIORITY(ARB_LSB_HIGH_PRIORITY)"
          },
          {
            "line": 73,
            "text": ")"
          },
          {
            "line": 74,
            "text": "priority_encoder_inst ("
          },
          {
            "line": 75,
            "text": "    .input_unencoded(request),"
          },
          {
            "line": 76,
            "text": "    .output_valid(request_valid),"
          },
          {
            "line": 77,
            "text": "    .output_encoded(request_index),"
          },
          {
            "line": 78,
            "text": "    .output_unencoded(request_mask)"
          },
          {
            "line": 79,
            "text": ");"
          },
          {
            "line": 80,
            "text": ""
          },
          {
            "line": 81,
            "text": "reg [PORTS-1:0] mask_reg = 0, mask_next;"
          },
          {
            "line": 82,
            "text": ""
          },
          {
            "line": 83,
            "text": "wire masked_request_valid;"
          },
          {
            "line": 84,
            "text": "wire [$clog2(PORTS)-1:0] masked_request_index;"
          },
          {
            "line": 85,
            "text": "wire [PORTS-1:0] masked_request_mask;"
          },
          {
            "line": 86,
            "text": ""
          },
          {
            "line": 87,
            "text": "priority_encoder #("
          },
          {
            "line": 88,
            "text": "    .WIDTH(PORTS),"
          },
          {
            "line": 89,
            "text": "    .LSB_HIGH_PRIORITY(ARB_LSB_HIGH_PRIORITY)"
