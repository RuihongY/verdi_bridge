          },
          {
            "line": 34,
            "text": "module arbiter #"
          },
          {
            "line": 35,
            "text": "("
          },
          {
            "line": 36,
            "text": "    parameter PORTS = 4,"
          },
          {
            "line": 37,
            "text": "    // select round robin arbitration"
          },
          {
            "line": 38,
            "text": "    parameter ARB_TYPE_ROUND_ROBIN = 0,"
          },
          {
            "line": 39,
            "text": "    // blocking arbiter enable"
          },
          {
            "line": 40,
            "text": "    parameter ARB_BLOCK = 0,"
          },
          {
            "line": 41,
            "text": "    // block on acknowledge assert when nonzero, request deassert when 0"
          },
          {
            "line": 42,
            "text": "    parameter ARB_BLOCK_ACK = 1,"
          },
          {
            "line": 43,
            "text": "    // LSB priority selection"
          },
          {
            "line": 44,
            "text": "    parameter ARB_LSB_HIGH_PRIORITY = 0"
          },
          {
            "line": 45,
            "text": ")"
          },
          {
            "line": 46,
            "text": "("
          },
          {
            "line": 47,
            "text": "    input  wire                     clk,"
