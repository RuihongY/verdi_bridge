          },
          {
            "line": 41,
            "text": "    parameter STRB_WIDTH = (DATA_WIDTH/8),"
          },
          {
            "line": 42,
            "text": "    // Timeout delay (cycles)"
          },
          {
            "line": 43,
            "text": "    parameter TIMEOUT = 4"
          },
          {
            "line": 44,
            "text": ")"
          },
          {
