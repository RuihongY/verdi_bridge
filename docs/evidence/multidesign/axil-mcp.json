            "line": 50,
            "text": "     * AXI-Lite slave interface"
          },
          {
            "line": 51,
            "text": "     */"
          },
          {
            "line": 52,
            "text": "    input  wire [ADDR_WIDTH-1:0]  s_axil_awaddr,"
          },
          {
            "line": 53,
            "text": "    input  wire [2:0]             s_axil_awprot,"
          },
          {
            "line": 54,
            "text": "    input  wire                   s_axil_awvalid,"
          },
          {
            "line": 55,
            "text": "    output wire                   s_axil_awready,"
          },
          {
            "line": 56,
            "text": "    input  wire [DATA_WIDTH-1:0]  s_axil_wdata,"
          },
          {
            "line": 57,
            "text": "    input  wire [STRB_WIDTH-1:0]  s_axil_wstrb,"
