[
  "codex",
  "exec",
  "--ignore-user-config",
  "--skip-git-repo-check",
  "--ephemeral",
  "--json",
  "-s",
  "read-only",
  "-C",
  "<demo-workspace>/case",
  "-c",
  "approval_policy=\"never\"",
  "-c",
  "mcp_servers.verdi.command=\"<project>/.venv/bin/verdi-bridge\"",
  "-c",
  "mcp_servers.verdi.args=[\"serve\"]",
  "-c",
  "mcp_servers.verdi.env.VERDI_BRIDGE_HOST=\"<ssh-host>\"",
  "-c",
  "mcp_servers.verdi.env.VERDI_BRIDGE_CONTROL_PATH=\"<control-socket>\"",
  "-c",
  "mcp_servers.verdi.env.VERDI_BRIDGE_DIR=\"<session>\"",
  "-c",
  "mcp_servers.verdi.default_tools_approval_mode=\"approve\"",
  "-c",
  "skills.config=[{path=\"<skills>/virtuoso/SKILL.md\",enabled=false}]",
  "-o",
  "<demo-workspace>/answer.md",
  "There is a bug. Find the relevant signals and analyze the problem. The error log is sim.log, and the RTL and testbench are in this directory. Please operate the connected Verdi session, show the key waveforms and source, and explain your findings in English."
]