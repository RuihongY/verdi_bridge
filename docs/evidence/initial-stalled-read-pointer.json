  "source": {
    "file": "/tmp/verdi-bridge-project/build/axis_fifo/stalled_read_pointer/axis_fifo.v",
    "definition_line": "189",
    "lines": [
      {
        "line": 375,
        "text": "always @(posedge clk) begin"
      },
      {
        "line": 376,
        "text": "    if (m_axis_tready_pipe) begin"
      },
      {
        "line": 377,
        "text": "        // output ready; invalidate stage"
      },
      {
        "line": 378,
        "text": "        m_axis_tvalid_pipe_reg[RAM_PIPELINE+1-1] <= 1'b0;"
      },
      {
        "line": 379,
        "text": "    end"
      },
      {
        "line": 380,
        "text": ""
      },
      {
        "line": 381,
        "text": "    for (j = RAM_PIPELINE+1-1; j > 0; j = j - 1) begin"
      },
      {
        "line": 382,
        "text": "        if (m_axis_tready_pipe || ((~m_axis_tvalid_pipe_reg) >> j)) begin"
      },
      {
        "line": 383,
        "text": "            // output ready or bubble in pipeline; transfer down pipeline"
      },
      {
        "line": 384,
        "text": "            m_axis_tvalid_pipe_reg[j] <= m_axis_tvalid_pipe_reg[j-1];"
      },
      {
        "line": 385,
        "text": "            m_axis_pipe_reg[j] <= m_axis_pipe_reg[j-1];"
      },
      {
        "line": 386,
        "text": "            m_axis_tvalid_pipe_reg[j-1] <= 1'b0;"
      },
      {
        "line": 387,
        "text": "        end"
      },
      {
        "line": 388,
        "text": "    end"
      },
      {
        "line": 389,
        "text": ""
      },
      {
        "line": 390,
        "text": "    if (m_axis_tready_pipe || ~m_axis_tvalid_pipe_reg) begin"
      },
      {
        "line": 391,
        "text": "        // output ready or bubble in pipeline; read new data from FIFO"
      },
      {
        "line": 392,
        "text": "        m_axis_tvalid_pipe_reg[0] <= 1'b0;"
      },
      {
        "line": 393,
        "text": "        m_axis_pipe_reg[0] <= mem[rd_ptr_reg[ADDR_WIDTH-1:0]];"
      },
      {
        "line": 394,
        "text": "        if (!empty && pipe_ready) begin"
      },
      {
        "line": 395,
        "text": "            // not empty, increment pointer"
      },
      {
        "line": 396,
        "text": "            m_axis_tvalid_pipe_reg[0] <= 1'b1;"
      },
      {
        "line": 397,
        "text": "            rd_ptr_reg <= rd_ptr_reg;"
      },
      {
        "line": 398,
        "text": "        end"
      },
      {
        "line": 399,
        "text": "    end"
      },
      {
        "line": 400,
        "text": ""
      },
      {
        "line": 401,
        "text": "    if (rst) begin"
      },
      {
        "line": 402,
        "text": "        rd_ptr_reg <= {ADDR_WIDTH+1{1'b0}};"
      },
      {
        "line": 403,
        "text": "        m_axis_tvalid_pipe_reg <= 0;"
      },
      {
        "line": 404,
